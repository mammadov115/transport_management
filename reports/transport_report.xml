<odoo>
    <record id="action_report_transport" model="ir.actions.report">
        <field name="name">Transport Order PDF</field>
        <field name="model">transport.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_management.report_transport_template</field>
        <field name="report_file">transport_management.report_transport_template</field>
        <field name="print_report_name">'Transport Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_transport_management"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_transport_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Sifariş: <span t-field="o.name"/></h2>
                        <br/>
                        <table class="table table-bordered">
                            <tr>
                                <td><strong>Daşıyıcı:</strong></td>
                                <td><span t-field="o.carrier_info"/></td>
                                <td><strong>Məhsul:</strong></td>
                                <td><span t-field="o.product_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Haradan:</strong></td>
                                <td><span t-field="o.from_location"/></td>
                                <td><strong>Haraya:</strong></td>
                                <td><span t-field="o.to_location"/></td>
                            </tr>
                            <tr>
                                <td><strong>Çatdırılma Tarixi:</strong></td>
                                <td><span t-field="o.delivery_period"/></td>
                                <td><strong>Nəqliyyat Növü:</strong></td>
                                <td><span t-field="o.transport_mode"/></td>
                            </tr>
                            <tr>
                                <td><strong>Incoterm:</strong></td>
                                <td colspan="3"><span t-field="o.incoterm"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>